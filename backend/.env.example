# Copy to backend/.env for local development

# Database connection URL
# Format: postgres://<DB_USER>:<DB_PASS>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=disable
DATABASE_URL=postgres://username:password@localhost:5432/endosoflow_dev?sslmode=disable
TEST_DATABASE_URL=postgres://username:password@localhost:5432/endosoflow_test?sslmode=disable

# Application configuration
ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text

# Signs access tokens (bash: openssl rand -base64 48)
JWT_SECRET=dev-only-secret-change-me-at-least-32-characters-long

# The frontend address, used in emailed activation and reset links
APP_BASE_URL=http://localhost:5173

# Set to true only when the API runs behind a proxy you control (Render): the client
# IP is then read from X-Forwarded-For for rate limiting. Leave false locally
TRUST_PROXY=false

# Codart identity API (DNI and RUC name lookup, 110 requests per month). Leave CODART_TOKEN
# empty to turn automatic lookup off: the screens then ask for the names manually.
CODART_TOKEN=
# CODART_BASE_URL=https://api-codart.cgrt.org
