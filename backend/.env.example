# Copy to backend/.env for local development

# Database connection URL
# Format: postgres://<DB_USER>:<DB_PASS>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=disable
DATABASE_URL=postgres://username:password@localhost:5432/endosoflow_dev?sslmode=disable
TEST_DATABASE_URL=postgres://username:password@localhost:5432/endosoflow_test?sslmode=disable

# Application configuration
ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text

# Signs access tokens (bash: openssl rand -base64 48)
JWT_SECRET=dev-only-secret-change-me-at-least-32-characters-long

# The frontend address, used in emailed activation and reset links.
APP_BASE_URL=http://localhost:5173
